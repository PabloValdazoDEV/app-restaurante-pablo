  <header>
        <h1 class="titulo">Cola de Pedidos</h1>
    </header>
    <main class="queue-container">
        <!-- Entrada -->
        <div class="queue-column entrada">
            <h2>Entrada</h2>
            {{#each pedidoEntrada}}
            <ul>
                <p><strong>Pedido Nº:</strong> {{orderNumber}}</p>
                {{#each products}}
                    <li>{{product.name}} - Cantidad: {{quantity}}</li>
                {{/each}}
            </ul>
            {{#if description}}
            <p><strong>Comentario del cliente:</strong> {{description}}</p>
            {{/if}}
            <form action="/order/queue/a-cocina?_method=PUT" method="post">
                <input type="hidden" name="id" value="{{id}}">
                <button type="submit" class="btn">Pasa a Cocina</button>
            </form>
            <br>
            {{/each}}
        </div>

        <!-- Cocina -->
        <div class="queue-column cocina">
            <h2>Cocina</h2>
            {{#each pedidoCocina}}
            <ul>
                <p><strong>Pedido Nº:</strong> {{orderNumber}}</p>
                {{#each products}}
                    <li>{{product.name}} - Cantidad: {{quantity}}</li>
                {{/each}}
            </ul>
            {{#if description}}
            <p><strong>Comentario del cliente:</strong> {{description}}</p>
            {{/if}}
            <form action="/order/queue/a-recoger?_method=PUT" method="post">
                <input type="hidden" name="id" value="{{id}}">
                <button type="submit" class="btn">Listo para Recoger</button>
            </form>
            <br>
            {{/each}}
        </div>

        <!-- Recoger -->
        <div class="queue-column recoger">
            <h2>Recoger</h2>
            {{#each pedidoRecoger}}
            <ul>
                <p><strong>Pedido Nº:</strong> {{orderNumber}}</p>
                {{#each products}}
                    <li>{{product.name}} - Cantidad: {{quantity}}</li>
                {{/each}}
            </ul>
            {{#if description}}
            <p><strong>Comentario del cliente:</strong> {{description}}</p>
            {{/if}}
            <form action="/order/queue/terminado?_method=PUT" method="post">
                <input type="hidden" name="id" value="{{id}}">
                <button type="submit" class="btn">Cerrar Pedido</button>
            </form>
            <br>
            {{/each}}
        </div>
    </main>

    <script>
        async function checkForTableUpdates() {
            try {
                const response = await fetch('/order/check-table');
                const data = await response.json();

                if (data.updated) {
                    location.reload();
                }
            } catch (error) {
                console.error('Error checking for updates:', error);
            }
        }

        setInterval(checkForTableUpdates, 7500);
    </script>