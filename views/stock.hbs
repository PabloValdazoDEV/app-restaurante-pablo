 <header>
        <h1 class="titulo">Stock</h1>
    </header>
    <main class="stock-container">
        {{#each products}}
        <div class="product-card">
            <h3>{{name}}</h3>
            <img src="{{imagen.url}}" alt="Imagen de {{name}}" class="product-image">
            <p><strong>Precio:</strong> {{price}}€</p>
            <p><strong>Stock:</strong> {{stock}}</p>
            <p><strong>Descripción:</strong> {{description}}</p>
            <div class="product-actions">
                <form action="/order/stock/delete/{{id}}?_method=DELETE" method="post">
                    <button type="submit" class="btn">Borrar</button>
                </form>
                <a href="/order/stock/edit/{{id}}" class="btn">Editar</a>
            </div>
        </div>
        {{/each}}
    </main>