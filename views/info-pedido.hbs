 <div class="info-container">
        <h1 class="titulo">Información del Pedido</h1>
        <p><strong>Estado del pedido:</strong> {{pedido.status}}</p>
        <p><strong>Email asociado al pedido:</strong> {{pedido.email}}</p>

        <p><strong>Has pedido:</strong></p>
        <ul class="pedido-list">
            {{#each pedido.products}}
            <li>{{product.name}} - Cant. {{quantity}} - {{product.price}}€ /ud</li>
            {{/each}}
        </ul>
        <p class="total-pagar"><strong>Total a pagar:</strong> <b>{{total}}€</b></p>
    </div>